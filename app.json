{
  "id": "com.thomastorp.nest-protect",
  "version": "1.0.1",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Nest Protect",
    "no": "Nest Protect"
  },
  "description": {
    "en": "Smoke, CO and heat alarms reach Homey the second they sound.",
    "no": "Røyk-, CO- og varmealarmer når Homey i samme sekund de uler."
  },
  "category": [
    "security"
  ],
  "tags": {
    "en": [
      "nest",
      "protect",
      "smoke",
      "carbon monoxide",
      "co",
      "fire",
      "alarm",
      "google"
    ],
    "no": [
      "nest",
      "protect",
      "røyk",
      "røykvarsler",
      "karbonmonoksid",
      "co",
      "brann",
      "alarm",
      "google"
    ]
  },
  "brandColor": "#00AFD8",
  "author": {
    "name": "Thomas Torp"
  },
  "contributors": {
    "developers": [
      {
        "name": "Thomas Torp"
      }
    ],
    "translators": [
      {
        "name": "Thomas Torp"
      }
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "torpthomas"
      },
      "githubSponsors": {
        "username": "torp93"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/torp93/homey-nest-protect/issues"
  },
  "source": "https://github.com/torp93/homey-nest-protect",
  "support": "https://github.com/torp93/homey-nest-protect/issues",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "permissions": [],
  "capabilities": {
    "alarm_manual_test": {
      "type": "boolean",
      "title": {
        "en": "Manual test",
        "no": "Manuell test"
      },
      "uiComponent": "sensor",
      "getable": true,
      "setable": false,
      "insights": true,
      "insightsTitleTrue": {
        "en": "Manual test started",
        "no": "Manuell test startet"
      },
      "insightsTitleFalse": {
        "en": "Manual test finished",
        "no": "Manuell test avsluttet"
      },
      "icon": "/assets/capability-icons/manual-test.svg"
    }
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "testCredentials": {
      "method": "POST",
      "path": "/testCredentials"
    },
    "refresh": {
      "method": "POST",
      "path": "/refresh"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "hazard_warning",
        "title": {
          "en": "A hazard warning started",
          "no": "Et farevarsel startet"
        },
        "titleFormatted": {
          "en": "Heads up for [[hazard]]",
          "no": "Forvarsel om [[hazard]]"
        },
        "hint": {
          "en": "Fires as soon as Nest reports a rising level, including when it goes straight to a full alarm. The alarm capabilities themselves only turn on at full alarm.",
          "no": "Fyrer så snart Nest melder et stigende nivå, også når det går rett til full alarm. Selve alarm-capabilityene slår først ut ved full alarm."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=protect"
          },
          {
            "name": "hazard",
            "type": "dropdown",
            "title": {
              "en": "Hazard",
              "no": "Fare"
            },
            "values": [
              {
                "id": "smoke",
                "title": {
                  "en": "smoke",
                  "no": "røyk"
                }
              },
              {
                "id": "co",
                "title": {
                  "en": "carbon monoxide",
                  "no": "karbonmonoksid"
                }
              },
              {
                "id": "heat",
                "title": {
                  "en": "heat",
                  "no": "varme"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "connection_changed",
        "title": {
          "en": "Connection to Nest changed",
          "no": "Forbindelsen til Nest endret seg"
        },
        "titleFormatted": {
          "en": "Connection to Nest went [[connection_state]]",
          "no": "Forbindelsen til Nest ble [[connection_state]]"
        },
        "hint": {
          "en": "Smoke alarms are silent for months at a time, so a broken connection looks exactly like a quiet house. Offline only fires after the connection has been down for an hour, so a brief network hiccup does not wake you; online only fires if you were told about the outage.",
          "no": "Røykvarslere er stille i månedsvis, så en brutt forbindelse ser nøyaktig ut som et rolig hus. Frakoblet utløses først når forbindelsen har vært nede i en time, så et kort nettverkshikk vekker deg ikke. Tilkoblet utløses bare hvis du faktisk fikk beskjed om bruddet."
        },
        "args": [
          {
            "name": "connection_state",
            "type": "dropdown",
            "title": {
              "en": "State",
              "no": "Tilstand"
            },
            "values": [
              {
                "id": "online",
                "title": {
                  "en": "online",
                  "no": "tilkoblet"
                }
              },
              {
                "id": "offline",
                "title": {
                  "en": "offline",
                  "no": "frakoblet"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "refresh_now",
        "title": {
          "en": "Fetch everything from Nest now",
          "no": "Hent alt fra Nest nå"
        },
        "hint": {
          "en": "Nest normally pushes changes as they happen, so this is rarely needed. Use it to confirm the connection works without waiting for something to change.",
          "no": "Nest sender vanligvis endringer når de skjer, så dette trengs sjelden. Bruk det for å bekrefte at forbindelsen virker uten å vente på at noe endrer seg."
        }
      }
    ],
    "conditions": [
      {
        "id": "is_connected",
        "title": {
          "en": "Nest !{{is|is not}} connected",
          "no": "Nest !{{er|er ikke}} tilkoblet"
        }
      }
    ]
  },
  "drivers": [
    {
      "id": "protect",
      "name": {
        "en": "Nest Protect",
        "no": "Nest Protect"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_smoke",
        "alarm_co",
        "alarm_heat",
        "alarm_battery",
        "alarm_tamper",
        "alarm_manual_test",
        "measure_voltage"
      ],
      "capabilitiesOptions": {
        "measure_voltage": {
          "title": {
            "en": "Battery voltage",
            "no": "Batterispenning"
          },
          "decimals": 3
        },
        "alarm_tamper": {
          "title": {
            "en": "Removed from base",
            "no": "Tatt av braketten"
          }
        }
      },
      "energy": {
        "batteries": [
          "AA",
          "AA",
          "AA",
          "AA",
          "AA",
          "AA"
        ]
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/protect/assets/images/small.png",
        "large": "/drivers/protect/assets/images/large.png",
        "xlarge": "/drivers/protect/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Device",
            "no": "Enhet"
          },
          "children": [
            {
              "id": "serial",
              "type": "label",
              "label": {
                "en": "Serial number",
                "no": "Serienummer"
              },
              "value": "—"
            },
            {
              "id": "model",
              "type": "label",
              "label": {
                "en": "Model",
                "no": "Modell"
              },
              "value": "—"
            },
            {
              "id": "power",
              "type": "label",
              "label": {
                "en": "Power",
                "no": "Strømkilde"
              },
              "value": "—"
            },
            {
              "id": "software",
              "type": "label",
              "label": {
                "en": "Software",
                "no": "Programvare"
              },
              "value": "—"
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Service",
            "no": "Vedlikehold"
          },
          "children": [
            {
              "id": "replaceBy",
              "type": "label",
              "label": {
                "en": "Replace by",
                "no": "Byttes innen"
              },
              "hint": {
                "en": "Nest Protect expires. After this date it stops being a certified alarm.",
                "no": "Nest Protect har utløpsdato. Etter denne datoen er den ikke lenger en godkjent varsler."
              },
              "value": "—"
            },
            {
              "id": "lastTest",
              "type": "label",
              "label": {
                "en": "Last manual test",
                "no": "Siste manuelle test"
              },
              "value": "—"
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Self-test",
            "no": "Selvtest"
          },
          "children": [
            {
              "id": "reportedAt",
              "type": "label",
              "label": {
                "en": "Last reported",
                "no": "Sist rapportert"
              },
              "hint": {
                "en": "When Nest last wrote a change about this unit — a few times a day, not on a schedule. Silence means nothing changed, not that the unit went quiet, so this bounds how old the readings are rather than proving they were re-checked.",
                "no": "Da Nest sist skrev en endring om denne enheten — noen ganger i døgnet, ikke etter en fast plan. Stillhet betyr at ingenting endret seg, ikke at enheten er borte. Verdien sier altså hvor gamle avlesningene høyst er, ikke at de er sjekket på nytt."
              },
              "value": "—"
            },
            {
              "id": "lastSelfTest",
              "type": "label",
              "label": {
                "en": "Last audio self-test",
                "no": "Siste lydtest"
              },
              "hint": {
                "en": "The automatic horn and speaker test. Nest runs it about monthly.",
                "no": "Den automatiske testen av horn og høyttaler. Nest kjører den omtrent månedlig."
              },
              "value": "—"
            },
            {
              "id": "checkSensors",
              "type": "label",
              "label": {
                "en": "Sensors",
                "no": "Sensorer"
              },
              "value": "—"
            },
            {
              "id": "checkAlarm",
              "type": "label",
              "label": {
                "en": "Alarm",
                "no": "Alarm"
              },
              "value": "—"
            },
            {
              "id": "checkVoice",
              "type": "label",
              "label": {
                "en": "Voice",
                "no": "Stemme"
              },
              "value": "—"
            },
            {
              "id": "checkBattery",
              "type": "label",
              "label": {
                "en": "Battery",
                "no": "Batteri"
              },
              "value": "—"
            },
            {
              "id": "checkWifi",
              "type": "label",
              "label": {
                "en": "Wi-Fi",
                "no": "Wi-Fi"
              },
              "value": "—"
            }
          ]
        }
      ]
    }
  ]
}
